# OpenRouter — ein Key fuer alle Modelle (Agenten + Schiedsrichter)
OPENROUTER_API_KEY=sk-or-v1-...

# Schiedsrichter-Modell: loest auf, WAS eine Aktion bewirkt.
# Muss fuer alle Nationen dasselbe sein, sonst ist nicht unterscheidbar,
# ob ein Unterschied vom Spieler oder vom Schiedsrichter kommt.
PAX_REFEREE_MODEL=anthropic/claude-sonnet-4.5

# Phos-Backend (immer lokal, hat keine Authentifizierung)
PAX_SERVER_URL=http://127.0.0.1:8000
